<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="1">

	<record id="cron_autovacuum_logs" model="ir.cron">
		<field name="name">MCP: Clean up audit logs</field>
		<field name="model_id" ref="model_muk_mcp_log"/>
		<field name="state">code</field>
		<field name="code">model._autovacuum_logs()</field>
		<field name="user_id" ref="base.user_root"/>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="numbercall">-1</field>
		<field name="doall" eval="False"/>
	</record>

	<record id="cron_autovacuum_sessions" model="ir.cron">
		<field name="name">MCP: Clean up inactive sessions</field>
		<field name="model_id" ref="model_muk_mcp_session"/>
		<field name="state">code</field>
		<field name="code">model._autovacuum_sessions()</field>
		<field name="user_id" ref="base.user_root"/>
		<field name="interval_number">1</field>
		<field name="interval_type">hours</field>
		<field name="numbercall">-1</field>
		<field name="doall" eval="False"/>
	</record>

	<record id="cron_autovacuum_notifications" model="ir.cron">
		<field name="name">MCP: Clean up notifications</field>
		<field name="model_id" ref="model_muk_mcp_notification"/>
		<field name="state">code</field>
		<field name="code">model._autovacuum_notifications()</field>
		<field name="user_id" ref="base.user_root"/>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="numbercall">-1</field>
		<field name="doall" eval="False"/>
	</record>

	<record id="cron_autovacuum_oauth_codes" model="ir.cron">
		<field name="name">MCP: Clean up expired OAuth codes</field>
		<field name="model_id" ref="model_muk_mcp_oauth_code"/>
		<field name="state">code</field>
		<field name="code">model._autovacuum_codes()</field>
		<field name="user_id" ref="base.user_root"/>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="numbercall">-1</field>
		<field name="doall" eval="False"/>
	</record>

</odoo>
