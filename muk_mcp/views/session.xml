<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_mcp_session_kanban" model="ir.ui.view">
		<field name="name">muk_mcp.session.kanban</field>
		<field name="model">muk_mcp.session</field>
		<field name="arch" type="xml">
			<kanban create="0">
				<field name="create_date"/>
				<field name="last_activity"/>
				<templates>
					<t t-name="kanban-box">
						<div class="d-flex">
							<div>
								<div>
									<strong>MCP Session</strong>
									<span class="ml-2 text-muted"><field name="create_date"/></span>
								</div>
								<small>Last activity: <field name="last_activity"/></small>
							</div>
							<button name="action_revoke" type="object" string="Revoke" class="btn btn-secondary ml-auto my-auto"/>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_mcp_session_list" model="ir.ui.view">
		<field name="name">muk_mcp.session.list</field>
		<field name="model">muk_mcp.session</field>
		<field name="arch" type="xml">
			<tree create="false">
				<field name="session_id"/>
				<field name="user_id"/>
				<field name="last_activity"/>
				<field name="create_date"/>
				<field name="active"/>
			</tree>
		</field>
	</record>

	<record id="action_mcp_session" model="ir.actions.act_window">
		<field name="name">Sessions</field>
		<field name="res_model">muk_mcp.session</field>
		<field name="view_mode">tree</field>
		<field name="context">{'active_test': False}</field>
	</record>

</odoo>
