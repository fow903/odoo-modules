<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.mcp</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//div[@name='integration']" position="after">
				<h2>MCP Server</h2>
				<div class="row mt16 o_settings_container" name="mcp_settings">
					<div class="col-12 col-lg-6 o_setting_box" id="mcp_session_timeout">
						<div class="o_setting_right_pane">
							<label string="Session Timeout" for="mcp_session_timeout"/>
							<div class="text-muted">
								Inactive sessions are cleaned up after this period.
							</div>
							<div class="content-group mt16">
								<field name="mcp_session_timeout" class="oe_inline"/>
								<span class="ml-2">in Hours</span>
							</div>
						</div>
					</div>
					<div class="col-12 col-lg-6 o_setting_box" id="mcp_log_retention">
						<div class="o_setting_right_pane">
							<label string="Log Retention" for="mcp_log_retention"/>
							<div class="text-muted">
								Audit logs older than this period are automatically deleted.
							</div>
							<div class="content-group mt16">
								<field name="mcp_log_retention" class="oe_inline"/>
								<span class="ml-2">in Days</span>
							</div>
						</div>
					</div>
					<div class="col-12 col-lg-6 o_setting_box" id="mcp_rate_limit">
						<div class="o_setting_right_pane">
							<label string="Rate Limiting" for="mcp_rate_limit_requests"/>
							<div class="text-muted">
								Default rate limit for new API keys. Set to 0 to disable.
							</div>
							<div class="content-group mt16">
								<field name="mcp_rate_limit_requests" class="oe_inline"/>
								<span class="ml-2">per Minute</span>
							</div>
						</div>
					</div>
					<div class="col-12 col-lg-6 o_setting_box" id="mcp_annotate_messages">
						<div class="o_setting_left_pane">
							<field name="mcp_annotate_messages"/>
						</div>
						<div class="o_setting_right_pane">
							<label for="mcp_annotate_messages"/>
							<div class="text-muted">
								Mark chatter messages originating from MCP.
							</div>
							<button
								name="%(muk_mcp.action_connect)d"
								type="action"
								string="Connect AI"
								icon="fa-arrow-right"
								class="btn-link mt-3"
							/>
						</div>
					</div>
					<div class="col-12 col-lg-6 o_setting_box" id="mcp_oauth_info">
						<div class="o_setting_right_pane">
							<span class="o_form_label">Claude Code Web (OAuth)</span>
							<div class="text-muted">
								Each user generates their own OAuth credentials in their profile
								(<strong>Settings → Users → MCP → Claude Code Web</strong>).
								Claude Code Web only needs the server URL to connect.
							</div>
						</div>
					</div>
				</div>
			</xpath>
		</field>
	</record>

</odoo>
